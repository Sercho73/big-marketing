---
const steps = [ ['Entendemos', 'Tu negocio, tu audiencia y los resultados que importan.'], ['Activamos', 'Campañas, contenido y automatizaciones conectadas.'], ['Optimizamos', 'Medimos, aprendemos y ajustamos para seguir creciendo.'] ];
---
<section class="method" id="metodo" aria-labelledby="method-title"><div class="shell">
  <div class="method-main"><h2 id="method-title" class="reveal">Creatividad humana.<br />Rendimiento aumentado.</h2><p class="method-description reveal">Performance marketing con IA. Definimos objetivos, activamos las acciones y optimizamos con datos reales.</p><div class="method-art"><img src="/images/big-growth-v2.webp" alt="Una flecha cromada ascendente atraviesa un anillo naranja" width="1536" height="1024" loading="lazy" /></div></div>
  <ol class="method-steps">{steps.map(([title, description],i) => <li class="reveal"><h3>0{i+1} / {title}</h3><p>{description}</p></li>)}</ol>
</div></section>
